#!/usr/bin/env python3
"""Forward URL requests over the existing private docker exec pipe."""
import fcntl
import json
import os
from pathlib import Path
import select
import socket
import sys

os.umask(0o077)
directory = Path.home()/".local/state/aiwork"
directory.mkdir(parents=True, exist_ok=True, mode=0o700)
lock = (directory/"native.lock").open("a")
fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
path = directory/"native.sock"
path.unlink(missing_ok=True)
with socket.socket(socket.AF_UNIX) as server:
    server.bind(str(path))
    server.listen(16)
    while True:
        ready, _, _ = select.select([server,sys.stdin.buffer],[],[])
        if sys.stdin.buffer in ready:
            break
        client, _ = server.accept()
        with client:
            client.settimeout(30)
            try:
                message = json.loads(client.makefile("rb").readline(32768))
                if message == {"action":"show"}:
                    req = message
                elif isinstance(message.get("url"),str):
                    req = {"action":"open","url":message["url"]}
                else:
                    raise ValueError()
                print(json.dumps(req), flush=True)
                reply = sys.stdin.buffer.readline(32768)
                if not reply: sys.exit()
                client.sendall(reply)
            except (OSError,ValueError):
                pass
