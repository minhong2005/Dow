#!/usr/bin/env python3
"""Source and generated gateway checks without private configuration or network."""
import ast
import json
import os
from pathlib import Path
import plistlib
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
os.chdir(root)
for path in sorted(root.rglob("*")):
    if not path.is_file() or any(s in path.parts for s in (".git", "node_modules", "__pycache__")):
        continue
    if path.suffix in (".json", ".mobileconfig"):
        if path.suffix == ".json":
            json.loads(path.read_text())
        else:
            plistlib.loads(path.read_bytes())
        continue
    if path.suffix not in ("", ".py", ".sh", ".js"):
        continue
    source = path.read_text()
    first = source.splitlines()[0] if source else ""
    if path.suffix == ".py" or "python" in first and first.startswith("#!"):
        ast.parse(source, str(path))
    elif first in ("#!/bin/bash", "#!/bin/sh"):
        subprocess.run([first[2:], "-n", path], check=True)
    elif path.suffix == ".js":
        subprocess.run(["node", "--check", path], check=True)

with tempfile.TemporaryDirectory() as tmp:
    env = dict(os.environ, DOW_CONFIG_DIR=tmp)
    config = Path(tmp) / "network.json"
    fixture = dict(expected="198.51.100.7", socks=dict(server="192.0.2.5", server_port=1080),
                   revision="016dd2cd-db56-445b-a1c5-59a303cdc5da")
    def read(*args):
        return subprocess.check_output(["./configure", *args], env=env, text=True).strip()
    for hop in (None, dict(server="192.0.2.6", server_port=8080)):
        fixture["hop"] = hop
        config.write_text(json.dumps(fixture))
        assert read("first-ip") == (hop or fixture["socks"])["server"]
        assert read("first-port") == str((hop or fixture["socks"])["server_port"])
        gateway = json.loads(read("gateway"))
        assert gateway["route"]["final"] == "fixed"
        assert gateway["outbounds"][0]["type"] == "socks"
        assert gateway["outbounds"][0].get("detour") == ("first" if hop else None)
        assert [o["type"] for o in gateway["outbounds"]] == (["socks", "http"] if hop else ["socks"])
    assert subprocess.run(["./configure", "gateway", "stale"], env=env, capture_output=True).returncode != 0
    read("activate", fixture["revision"])
    output = Path(tmp) / "expected-ip"
    assert output.read_text().strip() == fixture["expected"] and output.stat().st_mode & 0o777 == 0o600
    fixture["socks"]["server"] = "invalid"
    config.write_text(json.dumps(fixture))
    assert subprocess.run(["./configure", "gateway"], env=env, capture_output=True).returncode != 0
print("Source, proxy generation and configuration checks passed.")
