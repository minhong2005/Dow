#!/usr/bin/env python3
"""Refresh original main-project containers while preserving their running terminals."""
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import uuid

docker=["/opt/homebrew/bin/docker","--context","colima-dow"]
def call(*args):
    return subprocess.check_output([*docker,*args],text=True,timeout=45).strip()
def inspect(name):
    return json.loads(call("inspect",name))[0]
def inode(name,path):
    return call("exec",name,"stat","-Lc","%d:%i",path)

def reconcile():
    controller=inspect("aiwork-tools")
    if controller["HostConfig"]["NetworkMode"]!="none":
        raise RuntimeError("Unexpected workspace network")
    root=Path(next(m["Source"] for m in controller["Mounts"] if m["Destination"]=="/work"))
    shared=root/".dow-shared"
    if shared.is_symlink() or not shared.is_dir():
        raise RuntimeError("Invalid shared work directory")
    for name in call("ps","--filter","label=local.dow.project=main","--format","{{.Names}}").splitlines():
        if not re.fullmatch(r"dow-session-[0-9a-f]{24}",name):continue
        target=inspect(name)
        if target["Config"]["Labels"].get("org.dow.shared.tool"):continue
        if target["HostConfig"]["Privileged"] or not target["HostConfig"]["ReadonlyRootfs"]:raise RuntimeError("Unexpected worker configuration")
        tools=set(call("exec",name,"tmux","list-panes","-a","-F","#{@tool}").split())
        if len(tools)!=1:continue
        tool=tools.pop()
        if tool not in ("claude","agy","codex"):continue
        worker="dow-shared-"+tool+"-v1"
        peers = call("ps","--filter","label=org.dow.shared=v1","--format","{{.Names}}").splitlines()
        if worker not in peers or worker+"-browser" not in peers:
            subprocess.run([sys.executable,str(Path(__file__).with_name("workbench")),tool,"main","--prepare"],
                           check=True,timeout=90,env=dict(os.environ,PATH="/opt/homebrew/bin:"+os.environ.get("PATH","")))
        endpoint="/home/node/.local/state/aiwork/native.sock"
        try:
            ready=inode(name,"/work/.dow-shared")==inode(worker,"/work") and inode(name,endpoint)==inode(worker,endpoint) and inode(name,"/usr/local/lib/python3.11/dist-packages")==inode(worker,"/opt/dow-pillow")
        except subprocess.CalledProcessError:ready=False
        if ready:continue
        workspace=next(m["Source"] for m in target["Mounts"] if m["Destination"]=="/work/main" and m["Type"]=="bind")
        donor="dow-runtime-source-"+uuid.uuid4().hex[:12]
        try:
            call("run","-d","--rm","--name",donor,"--network","none","--cap-drop","ALL","--security-opt","no-new-privileges","--read-only",
                 "--mount",f"type=bind,source={workspace},target=/work/main,bind-recursive=disabled",
                 "--mount",f"type=bind,source={shared},target=/work/.dow-shared,bind-recursive=disabled",
                 "--mount",f"source=dow-shared-{tool}-v1-endpoint,target=/opt/runtime-endpoint,readonly",
                 "--mount","source=aiwork-home,target=/opt/runtime-pillow,volume-subpath=.local/state/aiwork/python-libs/pillow-13.0.0,readonly",
                 "--entrypoint","sleep","dow-project:1","infinity")
            subprocess.run(["/opt/homebrew/bin/colima","ssh","--profile","dow","--","sudo","-n","python3","-",
                                 str(inspect(donor)["State"]["Pid"]),str(target["State"]["Pid"])],
                                input=Path(__file__).with_name("attach_mounts.py").read_text(),text=True,check=True,timeout=30)
            print(name,tool,"updated",flush=True)
        finally:
            subprocess.run([*docker,"rm","-f",donor],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
if __name__=="__main__":
    state=Path.home()/"Library/Application Support/Dow/shared-runtime"
    state.mkdir(mode=0o700,parents=True,exist_ok=True)
    with (state/"refresh.lock").open("a") as f:
        fcntl.flock(f,fcntl.LOCK_EX)
        reconcile()
