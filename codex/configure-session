#!/usr/bin/env python3
"""Install Dow's sandbox network defaults and refresh the registered Mac tool."""
from contextlib import closing
import json
from pathlib import Path
import socket
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from assets import cache_archive

CLIENT = (
    "websocket_client-1.9.0-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/34/db/b10e48aa8fff7407e67470363eac595018441cf32d5e1001567a7aeba5d2/websocket_client-1.9.0-py3-none-any.whl",
    82616, "af248a825037ef591efbf6ed20cc5faa03d3b47b9e5a2230a529eeee1c1fc3ef",
)
CONTROL = "/home/node/.local/state/aiwork-codex/client.sock"


def request(ws, number, method, params):
    ws.send(json.dumps({"jsonrpc": "2.0", "id": number, "method": method, "params": params}))
    while True:
        reply = json.loads(ws.recv())
        if reply.get("id") == number:
            if "error" in reply:
                raise RuntimeError(reply["error"]["message"])
            return reply["result"]


def configure_github(ws):
    response = request(ws, 2, "config/read", {"includeLayers": True})
    layers = [layer for layer in response["layers"] if not layer.get("disabledReason")]
    user = next((layer for layer in layers if layer["name"]["type"] == "user"
                 and layer["name"].get("profile") is None), None)
    # Install defaults only. Leave existing network policy and custom profiles to their owner.
    for layer in layers:
        config = layer["config"]
        if ("network_proxy" in (config.get("features") or {})
                or "network_access" in (config.get("sandbox_workspace_write") or {})
                or "default_permissions" in config or "permissions" in config):
            return
    # Dow has no routable DNS server. The fixed upstream resolves these exact hostnames.
    # The managed proxy still checks its domain list, including for loopback destinations.
    policy = {"enabled": True, "allow_upstream_proxy": True, "allow_local_binding": True,
              "domains": {host: "allow" for host in
                          ("github.com", "api.github.com", "raw.githubusercontent.com")}}
    edits = [
        {"keyPath": "features.network_proxy", "value": policy, "mergeStrategy": "replace"},
        {"keyPath": "sandbox_workspace_write.network_access", "value": True, "mergeStrategy": "replace"},
    ]
    request(ws, 3, "config/batchWrite", {"edits": edits, "expectedVersion": user["version"] if user else None,
                                         "reloadUserConfig": True})


def main(context):
    docker = ["docker", "--context", context]
    running = subprocess.check_output(
        [*docker, "ps", "--filter", "name=^/aiwork-codex$", "--format", "{{.Names}}"], text=True
    ).strip()
    if not running:
        return  # The deploy step also runs this after the server starts.
    sys.path.insert(0, str(cache_archive(*CLIENT)))
    from websocket import create_connection

    # Carry the WebSocket frames through docker exec. No TCP listener or host mount.
    proxy = [*docker, "exec", "-i", "aiwork-tools", "/opt/codex/bin/codex",
             "app-server", "proxy", "--sock", CONTROL]
    client, peer = socket.socketpair()
    with client, peer:
        client.settimeout(10)
        process = subprocess.Popen(proxy, stdin=peer, stdout=peer)
        peer.close()
        try:
            with closing(create_connection("ws://localhost/", socket=client, timeout=10)) as ws:
                request(ws, 1, "initialize", {"clientInfo": {"name": "dow-installer", "version": "1"},
                                               "capabilities": {"experimentalApi": True}})
                ws.send(json.dumps({"jsonrpc": "2.0", "method": "initialized"}))
                configure_github(ws)
                request(ws, 4, "config/mcpServer/reload", None)
        finally:
            client.close()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


if __name__ == "__main__":
    main(sys.argv[1])
