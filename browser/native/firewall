#!/bin/sh
# Runs as root. Only the tagged browser and its driver use this group.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 077
uid=$1
userhome=$2
group=_dowchrome
anchor=com.apple/000.dow-chrome
state=/var/run/org.dow-workbench.chrome
mkdir -p "$state"
gid=$(dscl . -read "/Groups/$group" PrimaryGroupID | awk '{print $2}')
case "$gid" in ''|*[!0-9]*|0) exit 1 ;; esac
stop_browser() {
    pkill -TERM -G "$gid" 2>/dev/null || :
}
trap 'stop_browser; exit 0' TERM INT
rules="$state/rules"
cat > "$rules" <<EOF
pass out quick on lo0 inet proto tcp from any to 127.0.0.1 port 39175 group $gid flags S/SA keep state
block return out quick proto { tcp, udp } from any to any group $gid
EOF
# Use the OS's existing wildcard anchor. Never flush the system rules or states.
master_ready() { pfctl -sr 2>/dev/null | grep -Fq 'anchor "com.apple/*"'; }
if ! master_ready; then
    echo 'The system PF wildcard anchor is unavailable.' >&2
    exit 1
fi
if ! test -s "$state/token" || ! pfctl -s References 2>/dev/null | grep -Fq "$(cat "$state/token")"; then
    result=$(pfctl -E 2>&1)
    token=$(echo "$result" | awk '/Token/ {print $NF}')
    test -n "$token"
    echo "$token" > "$state/token"
fi
stop_browser
pfctl -a "$anchor" -f "$rules"
expected=$(pfctl -a "$anchor" -sr)
test -n "$expected"
child=
while :; do
    if ! master_ready || ! pfctl -si 2>/dev/null | grep -q 'Status: Enabled' ||
       [ "$(pfctl -a "$anchor" -sr 2>/dev/null)" != "$expected" ]; then
        stop_browser
        echo 'Browser stopped after its PF guard changed.' >&2
        exit 1
    fi
    if [ -z "$child" ] || ! kill -0 "$child" 2>/dev/null; then
        if launchctl print "gui/$uid" >/dev/null 2>&1 && [ -f "$userhome/Library/Application Support/dow-native/driver.py" ]; then
            launchctl asuser "$uid" /usr/bin/env -i PATH="$PATH" /usr/bin/python3 -I -S -c '
import os, pwd, sys
uid, gid = map(int, sys.argv[1:3])
home = sys.argv[3]
if uid < 501 or gid == 0 or pwd.getpwuid(uid).pw_dir != home: sys.exit(1)
os.setgroups([gid])
os.setgid(gid)
os.setuid(uid)
if (os.getuid(),os.geteuid(),os.getgid(),os.getegid()) != (uid,uid,gid,gid): sys.exit(1)
env = {"HOME":home, "USER":pwd.getpwuid(uid).pw_name, "PATH":"/usr/bin:/bin:/usr/sbin:/sbin"}
os.execve("/usr/bin/python3", ["python3","-I",home+"/Library/Application Support/dow-native/driver.py"],env)
' "$uid" "$gid" "$userhome" &
            child=$!
        fi
    fi
    sleep 3
done
